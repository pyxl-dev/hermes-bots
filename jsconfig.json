{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": false,
    "types": []
  },
  "include": ["app/**/*.js"],
  "exclude": ["app/vendor", "app/sw.js", "app/version.js", "app/report.js"]
}
