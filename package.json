{
  "name": "hermes-bots-pwa",
  "private": true,
  "type": "module",
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "solid-js": "1.9.19",
    "web-push": "3.6.7"
  },
  "scripts": {
    "check": "bun test/contract-check.ts",
    "typecheck": "tsc -p web/tsconfig.json",
    "smoke": "bun test/smoke.ts",
    "release": "bun scripts/release.ts",
    "stage": "bun server.ts stage",
    "promote": "bun server.ts promote",
    "rollback": "bun server.ts rollback",
    "check:snapshot": "sh test/contract-check.sh snapshot",
    "check:fresh": "sh test/contract-check.sh fresh",
    "hooks:install": "git config core.hooksPath .githooks",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "vite build --config web/vite.config.ts --logLevel warn",
    "dev": "vite --config web/vite.config.ts",
    "yaia": "$HOME/.hermes/hermes-agent/venv/bin/python scripts/yaia.py",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "vite": "8.2.6",
    "vite-plugin-solid": "2.11.16"
  }
}
